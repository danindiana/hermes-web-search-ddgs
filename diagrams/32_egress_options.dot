digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Egress options (review only, nothing changed)";
rankdir=TB;
q [label="Limit what the sandbox can reach?", color="#58a6ff", fillcolor="#13294d"];
a [label="A. DOCKER-USER rules\nblock RFC1918 + metadata,\nallow DNS, internet, host Ollama 11434\nAPPLIED (dedicated network + chain)", color="#3fb950", fillcolor="#1f2937"];
b [label="B. Egress proxy allowlist\ndomain-level control\nmore moving parts", color="#d29922", fillcolor="#1f2937"];
c [label="C. Leave open\nweb + pip + git all just work", color="#39c5cf", fillcolor="#0d2e2e"];
r [label="Trade-off: A may break access to LAN services\nthe agent legitimately uses; test first", color="#f0883e", shape=note];
q->a; q->b; q->c; r->a [style=dotted];
}
