digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Sandbox tool inventory (verified with command -v)";
subgraph cluster_p { label="Already present"; color="#58a6ff"; fontcolor="#58a6ff"; style=rounded;
 p [label="python3 pip node npm git curl wget\ngcc make dot ssh unzip\npdftotext ocrmypdf tesseract\ntorch 2.14+cu130 numpy pandas matplotlib", color="#58a6ff", fillcolor="#13294d"]; }
subgraph cluster_a { label="Added in :tools"; color="#3fb950"; fontcolor="#3fb950"; style=rounded;
 a [label="jq  ripgrep  tmux  sqlite3\nzip  rsync  ffmpeg  pandoc  gh", color="#3fb950", fillcolor="#1f2937"]; }
subgraph cluster_s { label="Deliberately skipped"; color="#d29922"; fontcolor="#d29922"; style="rounded,dashed";
 s [label="libreoffice  chromium\n(browser tool runs on the host)", color="#d29922", fillcolor="#1f2937"]; }
p->a [style=invis]; a->s [style=invis];
}
