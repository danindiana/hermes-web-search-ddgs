digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Full timeline of the work (all phases)";
a [label="1 Question:\nno web search?", color="#39c5cf", fillcolor="#0d2e2e"]; b [label="2 Diagnose:\ntoolsets off, no keys", color="#58a6ff", fillcolor="#13294d"]; c [label="3 ddgs + config\n(wrong env!)", color="#d29922", fillcolor="#1f2937"]; d [label="4 Docs + repo v1", color="#3fb950", fillcolor="#1f2937"];
e [label="5 Browser toolset\non (CLI test)", color="#58a6ff", fillcolor="#13294d"]; f [label="6 Sandbox gaps:\ntools image, GPU fix,\nhardening", color="#3fb950", fillcolor="#1f2937"]; g [label="7 Reload test\nconfirms GPU fix", color="#3fb950", fillcolor="#1f2937"]; h [label="8 E2E tests find:\nddgs invisible, browser\nin sandbox", color="#f85149"];
i [label="9 Fixes: post-setup,\nkeenable, blocklist,\ncleanup", color="#3fb950", fillcolor="#1f2937"]; j [label="10 Desktop image\nbrowser works", color="#3fb950", fillcolor="#1f2937"]; k [label="11 Egress policy\n+ docker restart test", color="#3fb950", fillcolor="#1f2937"]; l [label="12 Consolidated\ndocs (this)", color="#bc8cff"];
a->b->c->d->e->f->g->h->i->j->k->l;
