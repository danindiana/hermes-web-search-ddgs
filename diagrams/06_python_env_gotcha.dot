digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Which Python env does Hermes really load? (corrected)";
l [label="~/.local/bin/hermes -> runtime python3.14.7\n(run with -I: isolated)", color="#39c5cf", fillcolor="#0d2e2e"];
b [label="hermes_bootstrap prepends the managed env:\n~/.hermes/installs/<id>/environments/<id>/venv\n/lib/python3.14/site-packages", color="#3fb950", fillcolor="#1f2937"];
w [label="WRONG: pip install ddgs into the base\nruntime python (invisible under -I)", color="#f85149"];
x [label="Hermes log: 'ddgs package is not installed'\nsearch silently served by keyless rescue", color="#f0883e"];
f [label="RIGHT: hermes tools post-setup ddgs\n(installs the extra into the managed env)", color="#3fb950", fillcolor="#1f2937", penwidth=3];
v [label="Log now: 'DDGS search ...: 7 results'", color="#3fb950", fillcolor="#1f2937"];
l->b; w->x; b->f; f->v;
n [label="The earlier import check passed only from the plugin dir\n(namespace-package false positive) and from base python", color="#d29922", fillcolor="#1f2937", shape=note]; n->w [style=dotted];
}
