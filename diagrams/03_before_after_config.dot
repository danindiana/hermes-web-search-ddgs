digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Config change: before vs after";
subgraph cluster_b { label="BEFORE"; fontcolor="#f85149"; color="#f85149"; style=rounded;
 b1 [label="disabled_toolsets:\n  - search\n  - web\n  - x_search ...", color="#f85149"];
 b2 [label="cli: [file, skills,\nterminal, vision]", color="#f85149"];
 b3 [label="web: (absent)", color="#f85149"]; }
subgraph cluster_a { label="AFTER"; fontcolor="#3fb950"; color="#3fb950"; style=rounded;
 a1 [label="disabled_toolsets:\n  (web, search removed*)\n  - x_search ...", color="#3fb950", fillcolor="#1f2937"];
 a2 [label="cli: [file, web,\nskills, terminal, vision]", color="#3fb950", fillcolor="#1f2937"];
 a3 [label="web:\n  search_backend: ddgs", color="#3fb950", fillcolor="#1f2937"]; }
b1->a1; b2->a2; b3->a3;
n [label="* 'search' was removed from the deny list too; only 'web' is enabled for cli", color="#d29922", fillcolor="#1f2937", shape=note];
a1->n [style=dotted];
}
