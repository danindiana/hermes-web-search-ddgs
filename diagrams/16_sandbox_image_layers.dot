digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Sandbox image chain";
rankdir=TB;
base [label="hermes-sandbox:graphviz\n(earlier base: Debian 13, python, node, git, dot)", color="#39c5cf", fillcolor="#0d2e2e"];
pdf [label="hermes-sandbox:pdf\n+ poppler, qpdf, ghostscript, tesseract, ocrmypdf\n+ pypdf, pymupdf, pdfplumber, docling", color="#58a6ff", fillcolor="#13294d"];
tools [label="hermes-sandbox:tools  (NEW)\n+ jq ripgrep tmux sqlite3 zip rsync ffmpeg pandoc gh", color="#3fb950", fillcolor="#1f2937", penwidth=3];
base->pdf [label="Dockerfile.pdf"]; pdf->tools [label="Dockerfile.tools"];
n [label="Packages live in image layers, so they survive container recreation", color="#d29922", fillcolor="#1f2937", shape=note]; n->tools [style=dotted];
}
