digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Current state (2026-10-06)";
rankdir=TB;
h [label="Hermes agent", color="#58a6ff", fillcolor="#13294d"];
subgraph cluster_ok { label="Working + verified"; color="#3fb950"; fontcolor="#3fb950"; style=rounded;
 s [label="web_search\nddgs, log: 7 results", color="#3fb950", fillcolor="#1f2937"]; x [label="web_extract\nkeenable (3rd-party fetch)", color="#3fb950", fillcolor="#1f2937"]; t [label="terminal tool\nsandbox :desktop-tools", color="#3fb950", fillcolor="#1f2937"]; b [label="browser\nin sandbox, navigate + snapshot", color="#3fb950", fillcolor="#1f2937"]; g [label="2 GPUs in sandbox\nsurvives daemon-reload", color="#3fb950", fillcolor="#1f2937"]; e [label="egress filter\nLAN/metadata blocked, survives docker restart", color="#3fb950", fillcolor="#1f2937"]; }
subgraph cluster_p { label="Partial / open"; color="#d29922"; fontcolor="#d29922"; style=rounded;
 bl [label="domain blocklist\nbrowser yes, web_extract no", color="#d29922", fillcolor="#1f2937"]; rb [label="full machine reboot\nNOT tested", color="#d29922", fillcolor="#1f2937"]; br [label="Brave search\ndeferred (optional)", color="#d29922", fillcolor="#1f2937"]; }
h->s; h->x; h->t; h->b; t->g; t->e; h->bl; e->rb [style=dotted]; s->br [style=dotted];
}
