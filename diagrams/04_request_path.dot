digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Request path of one web_search call (DuckDuckGo backend)";
a [label="Hermes agent loop", color="#58a6ff", fillcolor="#13294d"];
t [label="tools/web_tools.py\n_get_search_backend()\nweb.search_backend = ddgs", color="#58a6ff", fillcolor="#13294d"];
p [label="plugins/web/ddgs/provider.py", color="#58a6ff", fillcolor="#13294d"];
w [label="disposable child process\n_search_worker.py", color="#bc8cff"];
l [label="ddgs package\nDDGS().text()", color="#3fb950", fillcolor="#1f2937"];
d [label="DuckDuckGo", color="#39c5cf", fillcolor="#0d2e2e"];
r [label="normalized hits\n(title, url, snippet)", color="#d29922", fillcolor="#1f2937"];
a->t [label="web_search(query)"]; t->p; p->w [label="spawn"]; w->l; l->d [label="HTTPS"]; d->l; l->w; w->p [label="stdout JSON"]; p->r; r->a;
}
