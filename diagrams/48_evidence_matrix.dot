label="Verification evidence matrix: claim -> source of truth";
rankdir=LR;
c1 [label="ddgs search real", color="#58a6ff", fillcolor="#13294d"]; e1 [label="agent.log\n'DDGS search: 7 results'", color="#3fb950", fillcolor="#1f2937"];
