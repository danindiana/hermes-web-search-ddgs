digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Verification: done vs still pending";
a [label="ddgs import + live query\nDONE", color="#3fb950", fillcolor="#1f2937"]; b [label="config parses (yaml)\nDONE", color="#3fb950", fillcolor="#1f2937"]; c [label="hermes tools list shows web\nDONE", color="#3fb950", fillcolor="#1f2937"];
d [label="Restart Hermes\nPENDING", color="#f85149"]; e [label="Agent runs a real web_search\nPENDING (unverified)", color="#f85149"];
a->b->c->d->e;
}
