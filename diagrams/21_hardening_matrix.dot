digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Hardening matrix: applied vs left open";
rankdir=TB;
h [label="Sandbox hardening", color="#58a6ff", fillcolor="#13294d"];
ap [label="Applied / already on", color="#3fb950", fillcolor="#1f2937"];
lo [label="Left open on purpose", color="#d29922", fillcolor="#1f2937"];
a1 [label="cap-drop ALL", color="#3fb950", fillcolor="#1f2937"]; a2 [label="non-root uid 1000", color="#3fb950", fillcolor="#1f2937"]; a3 [label="no-new-privileges (new)", color="#3fb950", fillcolor="#1f2937"]; a4 [label="pids-limit 512 (new)", color="#3fb950", fillcolor="#1f2937"]; a5 [label="4 GB RAM, 2 CPU", color="#3fb950", fillcolor="#1f2937"];
l1 [label="full network egress\n(web/curl wanted)", color="#d29922", fillcolor="#1f2937"]; l2 [label="rw /workspace + sandbox_ssh\n(real blast radius)", color="#f85149"]; l3 [label="writable rootfs, runc runtime", color="#d29922", fillcolor="#1f2937"];
h->ap; h->lo; ap->a1; ap->a2; ap->a3; ap->a4; ap->a5; lo->l1; lo->l2; lo->l3;
}
