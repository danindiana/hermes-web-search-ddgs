digraph g {
graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, pad=0.4];
node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
label="Risk model: browsing untrusted pages with a local model (illustrative)";
p [label="Untrusted web page", color="#d29922", fillcolor="#1f2937"];
i [label="Possible prompt injection\nin page text", color="#f85149"];
m [label="Local model reads snapshot", color="#58a6ff", fillcolor="#13294d"];
tm [label="terminal tool (Docker sandbox)", color="#bc8cff"];
fs [label="file tool (workspace mount)", color="#bc8cff"];
mit [label="Mitigations: empty profile (option 1),\nsandboxed terminal, no real-profile cookies,\nwatch actions after untrusted sites", color="#3fb950", fillcolor="#1f2937", shape=note];
p->i->m; m->tm; m->fs; mit->m [style=dotted];
}
